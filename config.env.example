# Email settings. Copy to config.env, fill in, then store as repo secrets with:
#   gh secret set -f config.env
# Gmail: pass = an App Password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Keep the quotes: the password contains spaces.
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
