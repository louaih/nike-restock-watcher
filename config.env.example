# Copy to config.env and fill in.

# --- Email (SMTP) ---
# Gmail: host smtp.gmail.com, port 587, user = your address,
# pass = an App Password (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# Keep the quotes: the password contains spaces.
SMTP_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Product ---
STYLE_COLOR=IO7254-133
PRODUCT_URL=https://www.nike.com/t/new-york-knicks-mens-standard-issue-basketball-jacket-OIc02ibp/IO7254-133
MARKETPLACE=US
# Only alert for these sizes (comma-separated). Leave empty for any size.
SIZES=
# Seconds between checks (jittered +/-20%).
INTERVAL_SECONDS=300

# Optional: route Nike requests through a proxy if Nike blocks your VPS IP (HTTP 403).
# HTTPS_PROXY=http://user:pass@proxy-host:port
