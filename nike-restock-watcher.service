[Unit]
Description=Nike restock email watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=nike-restock-watcher
WorkingDirectory=/opt/nike-restock-watcher
EnvironmentFile=/opt/nike-restock-watcher/config.env
Environment=STATE_FILE=/var/lib/nike-restock-watcher/state.json
ExecStart=/usr/bin/python3 /opt/nike-restock-watcher/watcher.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
